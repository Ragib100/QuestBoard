# Supabase → Project Settings → Database → Connection string → Session pooler.
# Swap the driver prefix to postgresql+psycopg:// and put your database password in.
# Use the *pooler* host (…pooler.supabase.com), not db.<ref>.supabase.co — the
# direct host is IPv6-only and will not resolve on most home networks.
DATABASE_URL=postgresql+psycopg://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Supabase → Project Settings → Data API
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=<anon / publishable key>

# Browser origins allowed to call this API. Only Flutter web needs it.
# "*" is fine locally; set your real domain(s) in production.
# These are *browser origins* (scheme + host + port), not bind addresses —
# "0.0.0.0" matches nothing and would block every web request.
CORS_ORIGINS=*

# Optional. Powers POST /api/ai/hint. With none of it set the endpoint returns
# 503 and the client hides the hint button rather than offering something that
# cannot work.
#
# Any OpenAI-compatible /chat/completions endpoint works. Free options, pick one:
#
#   Google Gemini  (best free tier — no card, ~1000 requests/day)
#     AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#     AI_MODEL=gemini-2.5-flash          key: aistudio.google.com/apikey
#
#   Groq           (very fast, free, no card)
#     AI_BASE_URL=https://api.groq.com/openai/v1
#     AI_MODEL=llama-3.3-70b-versatile   key: console.groq.com/keys
#
#   OpenRouter     (free models carry a :free suffix)
#     AI_BASE_URL=https://openrouter.ai/api/v1
#     AI_MODEL=meta-llama/llama-3.3-70b-instruct:free
#
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
