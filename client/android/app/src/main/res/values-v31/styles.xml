<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ (API 31) ignores android:windowBackground for the launch splash
     entirely and uses the platform splash screen API instead. Without this file
     the drawable-v21 splash above is dead on every recent phone. -->
<resources>
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowSplashScreenBackground">@color/launch_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">?android:colorBackground</item>
    </style>
</resources>
