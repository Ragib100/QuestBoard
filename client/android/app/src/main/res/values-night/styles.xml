<?xml version="1.0" encoding="utf-8"?>
<!-- The app is light-only (decisions.md D2), so these mirror values/styles.xml
     rather than switching to a black theme. The stock Flutter template used
     Theme.Black here, which made dark-mode phones flash black before the white
     UI appeared. -->
<resources>
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">?android:colorBackground</item>
    </style>
</resources>
