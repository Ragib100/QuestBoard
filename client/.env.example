SUPABASE_URL=your_supabase_url
SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key

# The deployed API. One HTTPS entry is all a shipped app needs, and it is the
# only setup that survives changing Wi-Fi networks — which is why the LAN
# address below is a development convenience, not the default.
API_URL=https://<your-app>.onrender.com

# For local server development, API_URL takes a comma-separated list instead.
# The app probes every candidate at once on the first request and keeps
# whichever answers, so one line works on desktop, an emulator and a phone:
#
#   http://localhost:8000        desktop, and USB phones with `adb reverse`
#   http://10.0.2.2:8000         Android emulator -> host machine
#   http://<your-pc-lan-ip>:8000 phone on the same Wi-Fi (`hostname -I`)
#
# API_URL=http://localhost:8000,http://10.0.2.2:8000,http://192.168.1.10:8000
#
# Two caveats on a phone: start the server with `--host 0.0.0.0` or it will
# never answer, and a *release* APK blocks cleartext HTTP entirely, so a local
# server is reachable only from a debug build.
