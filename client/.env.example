SUPABASE_URL=your_supabase_url
SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key

# API_URL takes a comma-separated list of candidates. On the first request the
# app probes all of them at once and keeps whichever answers, so the same .env
# works on desktop, an emulator and a phone without editing anything.
#
#   http://localhost:8000        desktop, and USB phones with `adb reverse`
#   http://10.0.2.2:8000         Android emulator -> host machine
#   http://<your-pc-lan-ip>:8000 phone on the same Wi-Fi (`hostname -I`)
#
# Replace the last one with your own LAN address. Start the server with
# `--host 0.0.0.0` so it accepts connections from the phone.
API_URL=http://localhost:8000,http://10.0.2.2:8000,http://192.168.1.10:8000

# When the API is deployed, one HTTPS entry is all you need:
# API_URL=https://<your-app>.onrender.com
