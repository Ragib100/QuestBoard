SUPABASE_URL=your_supabase_url
SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key
# Physical Android device over USB (recommended — run `adb reverse tcp:8000 tcp:8000`
# once per connection, then this works regardless of Wi-Fi or IP changes):
API_URL=http://localhost:8000
# Android emulator → host machine:      http://10.0.2.2:8000
# Physical device on the same Wi-Fi:    http://<your-pc-lan-ip>:8000
# Deployed API:                         https://<your-app>.onrender.com